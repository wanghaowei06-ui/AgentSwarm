diff --git a/src/agents/pi-embedded-runner/run/compaction-retry-intake.test.ts b/src/agents/pi-embedded-runner/run/compaction-retry-intake.test.ts
new file mode 100644
--- /dev/null
+++ b/src/agents/pi-embedded-runner/run/compaction-retry-intake.test.ts
@@ -0,0 +1,65 @@
+import { Agent } from "@mariozechner/pi-agent-core";
+import { convertToLlm } from "@mariozechner/pi-coding-agent";
+import { describe, expect, it } from "vitest";
+
+describe("compaction retry intake boundary", () => {
+  it("resumes the compacted transcript without appending a second Human user message", async () => {
+    const humanEventId = "$m1-human-event";
+    const seenUserMessages: string[] = [];
+    const llmContexts: Array<unknown[]> = [];
+    const assistantMessage = {
+      role: "assistant",
+      content: [{ type: "text", text: "ack" }],
+      api: "messages",
+      provider: "test",
+      model: "test-model",
+      usage: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0, totalTokens: 2 },
+      stopReason: "stop",
+      timestamp: Date.now(),
+    } as const;
+
+    const agent = new Agent({
+      initialState: {
+        systemPrompt: "test",
+        model: { provider: "test", id: "test-model", api: "messages" } as never,
+        tools: [],
+      },
+      convertToLlm,
+      streamFn: async (_model, context) => {
+        llmContexts.push(context.messages);
+        return {
+          result: async () => assistantMessage,
+          async *[Symbol.asyncIterator]() {
+            yield { type: "done", reason: "stop", message: assistantMessage };
+          },
+        } as never;
+      },
+    });
+
+    agent.subscribe((event) => {
+      if (event.type === "message_end" && event.message.role === "user") {
+        const text = event.message.content
+          .filter((part) => part.type === "text")
+          .map((part) => part.text)
+          .join("\n");
+        seenUserMessages.push(text);
+      }
+    });
+
+    await agent.prompt(humanEventId);
+    agent.state.messages = [
+      {
+        role: "compactionSummary",
+        summary: `Completed intake for ${humanEventId}; resume the existing work.`,
+        tokensBefore: 100,
+        timestamp: Date.now(),
+      } as never,
+    ];
+    await agent.continue();
+
+    expect(seenUserMessages).toEqual([humanEventId]);
+    expect(llmContexts).toHaveLength(2);
+    expect(llmContexts[1]).toHaveLength(1);
+    expect((llmContexts[1]?.[0] as { role?: string }).role).toBe("user");
+  });
+});
