{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentscope-ai/AgentTeams/testweaver/contracts/schemas/provenance-v1.json",
  "title": "TestWeaver Native Provenance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "testweaver.provenance/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "$ref": "common-v1.json#/$defs/Hash"
    },
    "provenance_id": {
      "$ref": "common-v1.json#/$defs/Identifier"
    },
    "native_refs": {
      "$ref": "common-v1.json#/$defs/NativeRefs"
    },
    "producer": {
      "$ref": "common-v1.json#/$defs/Producer"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common-v1.json#/$defs/ArtifactRef"
      }
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "artifact": {
      "$ref": "common-v1.json#/$defs/TransportArtifact"
    }
  },
  "required": [
    "schema_version",
    "version",
    "revision",
    "content_hash",
    "provenance_id",
    "native_refs",
    "producer",
    "source_refs",
    "method",
    "artifact"
  ]
}
