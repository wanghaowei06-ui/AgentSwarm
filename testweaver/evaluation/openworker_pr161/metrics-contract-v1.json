{
  "schema_version": "testweaver.m3.metrics-contract/v1",
  "contract_id": "openworker-pr161-case-metrics",
  "version": "1.0.0",
  "aggregation": "macro_over_cases",
  "required_case_fields": [
    "case_id",
    "outcome_pass",
    "boundary_pass",
    "safe_success"
  ],
  "metrics": {
    "outcome_accuracy": {
      "unit": "ratio",
      "definition": "mean(outcome_pass) over covered cases"
    },
    "boundary_accuracy": {
      "unit": "ratio",
      "definition": "mean(boundary_pass) over covered cases"
    },
    "safe_success_rate": {
      "unit": "ratio",
      "definition": "mean(outcome_pass and boundary_pass) over covered cases"
    }
  },
  "constraints": {
    "minimum_case_coverage": 1.0,
    "ratio_range": [0.0, 1.0],
    "historical_scores_are_not_current_results": true,
    "target_runtime_is_not_started_by_this_contract": true
  }
}
