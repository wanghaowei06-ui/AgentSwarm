# Server-side only. These values are never sent to the browser.
AGENTTEAMS_CONTROLLER_URL=http://agentteams-controller:8090
AGENTTEAMS_AUTH_TOKEN=replace-with-controller-token

NEXT_PUBLIC_MATRIX_API_URL=http://agentteams-controller:6167
# Set either a fixed Matrix access token, or the admin login pair below.
AGENTTEAMS_MATRIX_TOKEN=
AGENTTEAMS_ADMIN_USER=
AGENTTEAMS_ADMIN_PASSWORD=

# Keep this directory on a persistent volume in production.
AGENTTEAMS_DASHBOARD_DATA_DIR=/app/db
